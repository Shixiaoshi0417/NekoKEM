{
  "id": "io.github.shixiaoshi0417.NekoKEM",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "nekokem-gui",
  "finish-args": [
    "--share=ipc",
    "--socket=x11",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "nekokem",
      "buildsystem": "simple",
      "build-options": {
        "no-debuginfo": true,
        "strip": false
      },
      "build-commands": [
        "cd cli && sha256sum --check --quiet SHA256SUMS",
        "install -Dm755 cli/nekokem /app/bin/nekokem",
        "mkdir -p /app/lib",
        "cp -a --no-preserve=ownership gui /app/lib/nekokem",
        "ln -s ../lib/nekokem/bin/NekoKEM /app/bin/nekokem-gui",
        "install -Dm644 ${FLATPAK_ID}.desktop -t /app/share/applications",
        "install -Dm644 ${FLATPAK_ID}.metainfo.xml -t /app/share/metainfo",
        "install -Dm644 gui/lib/NekoKEM.png /app/share/icons/hicolor/128x128/apps/${FLATPAK_ID}.png",
        "install -Dm644 cli/LICENSE -t /app/share/licenses/${FLATPAK_ID}",
        "install -Dm644 gui/lib/app/resources/OpenSSL-LICENSE.txt -t /app/share/licenses/${FLATPAK_ID}"
      ],
      "sources": [
        {
          "type": "archive",
          "only-arches": [
            "x86_64"
          ],
          "url": "https://github.com/Shixiaoshi0417/NekoKEM/releases/download/v6.0.0/NekoKEM-linux-x86_64.tar.gz",
          "sha256": "fad6e581deca5cd8ac091bd1a8b8c2b6a76a8c89241cafc32264313e6e332647",
          "dest": "cli",
          "x-checker-data": {
            "type": "json",
            "url": "https://api.github.com/repos/Shixiaoshi0417/NekoKEM/releases/latest",
            "version-query": ".tag_name | sub(\"^v\"; \"\")",
            "url-query": ".assets[] | select(.name == \"NekoKEM-linux-x86_64.tar.gz\") | .browser_download_url"
          }
        },
        {
          "type": "archive",
          "only-arches": [
            "x86_64"
          ],
          "url": "https://github.com/Shixiaoshi0417/NekoKEM/releases/download/v6.0.0/NekoKEM-linux-x86_64-GUI.tar.gz",
          "sha256": "891654409def5b8ec11b5590e3b135d93ac689e4815bb7ce68bd5a868550809d",
          "dest": "gui",
          "x-checker-data": {
            "type": "json",
            "url": "https://api.github.com/repos/Shixiaoshi0417/NekoKEM/releases/latest",
            "version-query": ".tag_name | sub(\"^v\"; \"\")",
            "url-query": ".assets[] | select(.name == \"NekoKEM-linux-x86_64-GUI.tar.gz\") | .browser_download_url",
            "is-main-source": true
          }
        },
        {
          "type": "archive",
          "only-arches": [
            "aarch64"
          ],
          "url": "https://github.com/Shixiaoshi0417/NekoKEM/releases/download/v6.0.0/NekoKEM-linux-aarch64.tar.gz",
          "sha256": "c0d68478c46312ea9467867a5fc5a12de187375453e9c3d8bf9da13f753da834",
          "dest": "cli",
          "x-checker-data": {
            "type": "json",
            "url": "https://api.github.com/repos/Shixiaoshi0417/NekoKEM/releases/latest",
            "version-query": ".tag_name | sub(\"^v\"; \"\")",
            "url-query": ".assets[] | select(.name == \"NekoKEM-linux-aarch64.tar.gz\") | .browser_download_url"
          }
        },
        {
          "type": "archive",
