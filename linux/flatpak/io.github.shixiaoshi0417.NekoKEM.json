            "aarch64"
          ],
          "url": "https://github.com/Shixiaoshi0417/NekoKEM/releases/download/v6.0.0/NekoKEM-linux-aarch64-GUI.tar.gz",
          "sha256": "00c367cdfc820cc3ea7cc279430d5018f765f7c023751eb5cc2e7768b5f84f9b",
          "dest": "gui",
          "x-checker-data": {
            "type": "json",
            "url": "https://api.github.com/repos/Shixiaoshi0417/NekoKEM/releases/latest",
            "version-query": ".tag_name | sub(\"^v\"; \"\")",
            "url-query": ".assets[] | select(.name == \"NekoKEM-linux-aarch64-GUI.tar.gz\") | .browser_download_url"
          }
        },
        {
          "type": "file",
          "path": "io.github.shixiaoshi0417.NekoKEM.desktop"
        },
        {
          "type": "file",
          "path": "io.github.shixiaoshi0417.NekoKEM.metainfo.xml"
        }
      ]
    }
  ]
}
