    <screenshot>
      <caption>Settings</caption>
      <image>https://raw.githubusercontent.com/Shixiaoshi0417/NekoKEM/main/linux/flatpak/screenshots/settings.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#f2f2f2</color>
