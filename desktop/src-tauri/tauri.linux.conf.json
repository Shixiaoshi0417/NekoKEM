{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["deb", "rpm"],
    "icon": [
      "build-resources/linux-32x32.png",
      "build-resources/linux-128x128.png",
      "build-resources/linux-128x128@2x.png"
    ],
    "resources": {
      "build-resources/openssl-LICENSE.txt": "licenses/OpenSSL-LICENSE.txt",
      "build-resources/NekoKEM-LICENSE.txt": "licenses/NekoKEM-LICENSE.txt"
    },
    "linux": {
      "deb": {
        "depends": ["libc6 (>= 2.39)", "libgcc-s1", "libdbus-1-3", "libgtk-3-0t64", "libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]
      },
      "rpm": {
        "release": "1",
        "depends": [
          "libc.so.6(GLIBC_2.39)(64bit)",
          "libc.so.6()(64bit)",
          "libm.so.6()(64bit)",
          "libgcc_s.so.1()(64bit)",
          "libdbus-1.so.3()(64bit)",
          "libgtk-3.so.0()(64bit)",
          "libgdk-3.so.0()(64bit)",
          "libgdk_pixbuf-2.0.so.0()(64bit)",
          "libcairo.so.2()(64bit)",
          "libglib-2.0.so.0()(64bit)",
          "libgobject-2.0.so.0()(64bit)",
          "libgio-2.0.so.0()(64bit)",
          "libsoup-3.0.so.0()(64bit)",
          "libwebkit2gtk-4.1.so.0()(64bit)",
          "libjavascriptcoregtk-4.1.so.0()(64bit)"
        ]
      }
    }
  }
}
