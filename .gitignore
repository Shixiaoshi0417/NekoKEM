# Locally compiled Android OpenSSL prefix; rebuild with the checked-in script
/NekoKEM-Android/app/src/main/cpp/third_party/openssl/

# Runtime keys and sensitive key/certificate containers
*.nkpr
*.nkpr.enc
*.key
*.key.enc
*.pem
*.der
*.p12
*.pfx
*.keystore
*.jks
*.pk8
*.csr
*.crt

# Git-only exclusions: keep local runtime files and preserve directory markers
# These patterns never delete local files; they only prevent Git tracking.
/keys/**
!/keys/.gitkeep
/plaintext/**
!/plaintext/.gitkeep
/encrypted/**
!/encrypted/.gitkeep

# Fuzz, crash, benchmark, and generated corpus output
/fuzz/bin/
/fuzz/out/
/fuzz/findings/
/fuzz/crashes/
/fuzz/hangs/
/fuzz/queue/
/fuzz/seeds/nkem/valid-v3
**/crash-*
**/id:*
**/benchmark/
**/benchmarks/
**/benchmark-results/

