    <string name="confirm_temporary_public_key_message">檔案：%1$s\n\n指紋：\n%2$s\n\n此金鑰僅使用一次，不會取代 App 預設公鑰。</string>
    <string name="delete_private_key_title">永久刪除私鑰？</string>
    <string name="delete_private_key_message">將刪除本機 NKPR 私鑰及相關暫存快取。公鑰會保留。</string>
    <string name="delete_public_key_title">永久刪除公鑰？</string>
    <string name="delete_public_key_message">將刪除 App 內預設公鑰。加密私鑰會保留。</string>
    <string name="delete_keypair_title">永久刪除金鑰對？</string>
    <string name="delete_keypair_message">將刪除本機公鑰、加密 NKPR 私鑰及相關暫存快取。</string>
    <string name="replace_private_key_title">取代現有私鑰？</string>
    <string name="replace_private_key_message">僅在加密 NKPR 私鑰的格式及密碼驗證成功、且確認與目前公鑰配對後，才會取代目前本機私鑰。</string>
    <string name="replace_public_key_title">取代本機公鑰？</string>
    <string name="replace_public_key_message">這會取代你自己的公鑰，即他人為你加密檔案時使用的公鑰。若要保存他人的公鑰，請改為在公鑰通訊錄中新增。</string>
    <string name="replace_public_key_pair_note">本機已有私鑰，新公鑰必須與之配對。接下來需要輸入該私鑰的密碼進行確認。</string>
    <string name="import_public_key_password_title">確認金鑰對</string>
    <string name="import_public_key_password_message">請輸入本機私鑰的密碼。僅當公鑰屬於該私鑰時才會取代。</string>
    <string name="replace_keypair_title">取代現有金鑰對？</string>
    <string name="replace_keypair_message">產生新的金鑰對會取代目前的公鑰和私鑰。之後，以目前公鑰加密的檔案只能用目前私鑰解密，請先匯出並備份加密私鑰。</string>
